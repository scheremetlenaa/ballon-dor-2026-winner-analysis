	column SofascoreID
		dataType: int64
		formatString: 0
		lineageTag: cca8a94b-4c43-4f27-a41b-1afe464f8173
		summarizeBy: count
		sourceColumn: SofascoreID

		annotation SummarizationSetBy = Automatic

	column Rank =
			
			LOOKUPVALUE(
			    FactVoting[Rank],
			    FactVoting[PlayerID],
			    DimPlayer[PlayerID]
			)
		formatString: 0
		lineageTag: 8b1f079e-868f-4917-b86f-0f99632a0176
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'In Top 10' = NOT ISEMPTY ( RELATEDTABLE ( FactPlayerSeason ) )
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 75b1cbfb-a007-4696-83fa-7a4a0b697774
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Latest Rank' =
			
			VAR LastYear = MAXX ( ALL ( DimSeason ), DimSeason[BallonDorYear] )
			RETURN
			    MINX (
			        FILTER ( RELATEDTABLE ( FactVoting ), RELATED ( DimSeason[BallonDorYear] ) = LastYear ),
			        FactVoting[Rank]
			    )
		formatString: 0
		lineageTag: ab0b5c55-f1d1-4df2-a92f-cc984850e81a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

