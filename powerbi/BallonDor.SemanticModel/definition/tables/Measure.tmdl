	measure 'BdO Index' =
			
			VAR wO = LOOKUPVALUE ( IndexWeights[Weight], IndexWeights[Component], "Output" )
			VAR wT = LOOKUPVALUE ( IndexWeights[Weight], IndexWeights[Component], "Trophies" )
			VAR wB = LOOKUPVALUE ( IndexWeights[Weight], IndexWeights[Component], "BigGames" )
			RETURN
			    IF (
			        NOT ISBLANK ( [Pctl Output] ),
			        wO * [Pctl Output] + wT * [Pctl Trophies] + wB * [Pctl BigGames]
			    )
		displayFolder: 8 - Index
		lineageTag: de9f90d2-0b92-4d27-9409-187bb15619d9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'BdO Index Rank' =
			
			VAR Cur = [BdO Index]
			RETURN
			    IF (
			        NOT ISBLANK ( Cur ),
			        CALCULATE (
			            RANKX ( VALUES ( FactPlayerSeason[PlayerID] ), [BdO Index], Cur, DESC, DENSE ),
			            FactPlayerSeason[IsNominee] = TRUE (),
			            REMOVEFILTERS ( DimPlayer ),
			            REMOVEFILTERS ( FactPlayerSeason[PlayerID] )
			        )
			    )
		formatString: 0
		displayFolder: 8 - Index
		lineageTag: 4b128022-36a5-4e85-b1d0-d15d25816cb6

	measure 'Index Picked Winner' =
			
			VAR Tbl =
			    CALCULATETABLE (
			        ADDCOLUMNS ( VALUES ( FactPlayerSeason[PlayerID] ), "@idx", [BdO Index] ),
			        FactPlayerSeason[IsNominee] = TRUE (),
			        REMOVEFILTERS ( DimPlayer ),
			        REMOVEFILTERS ( FactPlayerSeason[PlayerID] )
			    )
			VAR TopPlayer = MAXX ( TOPN ( 1, Tbl, [@idx], DESC ), FactPlayerSeason[PlayerID] )
			VAR Actual =
			    CALCULATE ( MAX ( FactVoting[PlayerID] ), FactVoting[Rank] = 1, REMOVEFILTERS ( DimPlayer ) )
			RETURN
			    IF ( HASONEVALUE ( DimSeason[SeasonID] ) && NOT ISBLANK ( Actual ), IF ( TopPlayer = Actual, 1, 0 ) )
		formatString: 0
		displayFolder: 8 - Index
		lineageTag: 887a6795-5ebb-43aa-8b54-049e4910f1c7

	measure 'Index Hit Rate %' =
			
			AVERAGEX ( VALUES ( DimSeason[SeasonID] ), [Index Picked Winner] )
		formatString: 0.0%
		displayFolder: 8 - Index
		lineageTag: e292cb3e-5de8-4293-86c8-80b57471239f

	measure 'Minutes with xG' = CALCULATE ( [Minutes], NOT ISBLANK ( FactPlayerMatch[xG] ) )
		formatString: 0
		displayFolder: 1 - Output
		lineageTag: b419138b-c7e5-4fcc-a697-633c68ae9ea6

	measure 'xG Coverage %' = DIVIDE ( [Minutes with xG], [Minutes] )
		formatString: 0.0%
		displayFolder: 1 - Output
		lineageTag: b37bc0e7-4436-43ab-9804-b666357f5990

	measure 'xG (incl. estimate)' = SUM ( FactPlayerMatch[xGIncEst] )
		formatString: 0.0
		displayFolder: 1 - Output
		lineageTag: c5ded9ad-35d9-48f6-8af5-b38a4037038b

	measure 'npxG (incl. estimate)' = SUM ( FactPlayerMatch[npxGIncEst] )
		formatString: 0.0
		displayFolder: 1 - Output
		lineageTag: 7ea5b741-6c5d-4c68-81a4-1e9b8e7b2bab

	measure 'Estimated npxG Share %' = DIVIDE ( CALCULATE ( [npxG (incl. estimate)], FactPlayerMatch[IsXgEstimated] = TRUE () ), [npxG (incl. estimate)] )
		formatString: 0.0%
		displayFolder: 1 - Output
		lineageTag: 00ada946-7a0e-44bd-a976-b9bf81e47f00

	measure 'Season npxG per 90' = DIVIDE ( SUM ( FactPlayerSeason[npxG] ) * 90, SUM ( FactPlayerSeason[MinutesWithXg] ) )
		formatString: 0.00
		displayFolder: 6 - History
		lineageTag: c25f24da-98d8-4abd-82a1-6072b50ffc1b

	measure 'Season npxG (incl. estimate)' = SUM ( FactPlayerSeason[npxGIncEst] )
		formatString: 0.0
		displayFolder: 6 - History
		lineageTag: 521238e0-85fe-497b-ae15-5b5282ef7841

	measure 'Rival Color' =
			
			IF (
			    SELECTEDVALUE ( Rivals[PlayerName] ) = SELECTEDVALUE ( DimPlayer[PlayerName] ),
