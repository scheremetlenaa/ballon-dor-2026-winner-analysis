	measure 'Pctl Output' =
			
			VAR Cur = [Season NP G+A]
			VAR Tbl =
			    CALCULATETABLE (
			        ADDCOLUMNS ( VALUES ( FactPlayerSeason[PlayerID] ), "@v", [Season NP G+A] ),
			        FactPlayerSeason[IsNominee] = TRUE (),
			        REMOVEFILTERS ( DimPlayer ),
			        REMOVEFILTERS ( FactPlayerSeason[PlayerID] )
			    )
			VAR N = COUNTROWS ( Tbl )
			VAR Below = COUNTROWS ( FILTER ( Tbl, [@v] < Cur ) ) + 0   -- COUNTROWS of an empty table is BLANK, not 0
			RETURN
			    IF ( HASONEVALUE ( DimSeason[SeasonID] ) && NOT ISBLANK ( Cur ), DIVIDE ( Below, N - 1 ) )
		formatString: 0.0%
		displayFolder: 7 -Percentiles
		lineageTag: 983a6d92-e26a-421d-9407-f8e653628ef4

	measure 'Pctl Trophies' =
			
