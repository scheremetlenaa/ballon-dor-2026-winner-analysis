	measure 'Winner Margin (pts)' =
			
			VAR P1 = CALCULATE ( SUM ( FactVoting[Points] ), FactVoting[Rank] = 1, REMOVEFILTERS ( DimPlayer ) )
			VAR P2 = CALCULATE ( SUM ( FactVoting[Points] ), FactVoting[Rank] = 2, REMOVEFILTERS ( DimPlayer ) )
			RETURN IF ( NOT ISBLANK ( P1 ), P1 - P2 )
		formatString: 0
		displayFolder: 5 - Voting
		lineageTag: 6477e16a-a5d0-4b25-8568-d0414f51f377

	measure 'Winner Margin %' =
			
			VAR P1 = CALCULATE ( SUM ( FactVoting[Points] ), FactVoting[Rank] = 1, REMOVEFILTERS ( DimPlayer ) )
			VAR P2 = CALCULATE ( SUM ( FactVoting[Points] ), FactVoting[Rank] = 2, REMOVEFILTERS ( DimPlayer ) )
