	measure 'Avg Winner NP G+A (baseline)' =
			
			VAR FromYear = 2015
			VAR ToYear = 2025
			RETURN
			    CALCULATE (
			        AVERAGEX (
			            FILTER ( FactPlayerSeason, FactPlayerSeason[IsBallonDorWinner] ),
			            FactPlayerSeason[Goals] - FactPlayerSeason[PenaltyGoals] + FactPlayerSeason[Assists]
			        ),
			        REMOVEFILTERS ( DimPlayer ),
			        REMOVEFILTERS ( DimTeam ),
			        REMOVEFILTERS ( DimSeason ),
			        DimSeason[BallonDorYear] >= FromYear,
			        DimSeason[BallonDorYear] <= ToYear
			    )
		displayFolder: 6 - History
		lineageTag: 94a8d374-4fe4-4f93-9024-a6c0cfb8d898

		annotation PBI_FormatHint = {"isGeneralNumber":true}

