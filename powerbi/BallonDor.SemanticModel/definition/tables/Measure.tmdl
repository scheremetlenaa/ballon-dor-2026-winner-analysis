	measure 'G+A Rolling 5' =
			
			VAR CurrentDate = MAX ( DimDate[Date] )
			VAR Last5 =
			    TOPN (
			        5,
			        CALCULATETABLE (
			            SUMMARIZE ( FactPlayerMatch, FactPlayerMatch[MatchID], FactPlayerMatch[Date] ),
			            FactPlayerMatch[Minutes] > 0,
			            FactPlayerMatch[Date] <= CurrentDate,
			            REMOVEFILTERS ( DimDate )
			        ),
			        FactPlayerMatch[Date], DESC
			    )
			RETURN
			    IF (
			        NOT ISEMPTY ( FactPlayerMatch ),
			        DIVIDE ( CALCULATE ( [G+A], Last5, REMOVEFILTERS ( DimDate ) ), COUNTROWS ( Last5 ) )
			    )
		displayFolder: 4 - Consistency
		lineageTag: b75b83c6-20d8-4b8a-ae37-8344fb5b48f1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

