	column VotingRank =
			
			VAR s = FactPlayerSeason[SeasonID]
			VAR p = FactPlayerSeason[PlayerID]
			RETURN
			    MAXX (
			        FILTER ( FactVoting, FactVoting[SeasonID] = s && FactVoting[PlayerID] = p ),
			        FactVoting[Rank]
			    )
		formatString: 0
		lineageTag: b08c08e3-a6e2-4355-abce-2df7b261cafe
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column IsNominee = NOT ISBLANK ( FactPlayerSeason[VotingRank] )
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 2c5bbffe-1aa4-4b6b-890b-0f556c6601fd
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column IsBallonDorWinner = FactPlayerSeason[VotingRank] = 1
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 326fc0a1-0678-49fd-b450-b943676955bb
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column AgeAtSeasonEnd =
			
			INT ( YEARFRAC ( RELATED ( DimPlayer[BirthDate] ), RELATED ( DimSeason[EndDate] ) ) )
		formatString: 0
		lineageTag: b6d6da5c-f0ad-43d1-8150-8ba21d3f8492
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column TrophiesWon =
			
			VAR s = FactPlayerSeason[SeasonID]
			VAR p = FactPlayerSeason[PlayerID]
			RETURN
			    COUNTROWS (
			        FILTER (
			            FactPlayerCompetition,
			            FactPlayerCompetition[SeasonID] = s
			                && FactPlayerCompetition[PlayerID] = p
			                && FactPlayerCompetition[IsWinner]
			        )
			    ) + 0
		formatString: 0
		lineageTag: f860072c-cc8e-4491-acc6-e81b82cf6cb8
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column TrophyScore =
			
			VAR s = FactPlayerSeason[SeasonID]
			VAR p = FactPlayerSeason[PlayerID]
			RETURN
			    SUMX (
			        FILTER (
			            FactPlayerCompetition,
			            FactPlayerCompetition[SeasonID] = s
			                && FactPlayerCompetition[PlayerID] = p
			                && FactPlayerCompetition[IsWinner]
			        ),
			        FactPlayerCompetition[TrophyWeight]
			    ) + 0
		lineageTag: ec9fb7ac-3391-4466-9976-7d07262acf34
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

